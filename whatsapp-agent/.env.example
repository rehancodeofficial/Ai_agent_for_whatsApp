# Google Gemini LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Thinking tokens share the reply budget: 0 keeps replies from being cut off,
# -1 lets the model decide.
GEMINI_THINKING_BUDGET=0
LLM_PRICE_INPUT=0.10
LLM_PRICE_OUTPUT=0.40

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_agent

# Odoo XML-RPC Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_API_KEY=your_odoo_api_key_here

# Meta WhatsApp Cloud API Configuration
WA_TOKEN=your_whatsapp_token_here
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_VERIFY_TOKEN=default_verify_token
WA_APP_SECRET=your_app_secret_here
STAFF_ALERT_PHONE=+923000000000

# Resend Email Agent Configuration
# Create the API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Must be an address on a domain you have verified in Resend
RESEND_FROM_EMAIL=Al-Madina Store <support@yourdomain.com>
# Optional: where customer replies should go, if not the From address
RESEND_REPLY_TO=
# Signing secret of the Resend webhook subscribed to the "email.received" event
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Set to true once the three values above are filled in
EMAIL_AGENT_ENABLED=false
# Optional: staff address for human-handoff alerts raised over email
STAFF_ALERT_EMAIL=

# Handoff / Admin Security
ADMIN_TOKEN=admin_secret

# Environment & Logging
ENV=development
LOG_LEVEL=INFO
BUSINESS_NAME=Al-Madina Store
